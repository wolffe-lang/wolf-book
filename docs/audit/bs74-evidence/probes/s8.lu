enum Maybe[T] { Just(T), Nothing }
fn cents_or(m: Maybe[int], fallback: int) -> int {
    match m {
        Just(c) => c,
        Nothing => fallback,
    }
}
fn main() -> !int {
    let found = Maybe.Just(340)
    let missing: Maybe[int] = Maybe.Nothing
    print("{cents_or(found, 0)} {cents_or(missing, 0)}")
    0
}
