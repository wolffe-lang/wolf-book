enum Kind { Drink, Food, Gratuity }
enum Line { Item(Kind, int), Tip(int), Void }
fn say(l: Line) -> str {
    match l {
        Item(Drink, _) => "a drink",
        Item(_, _) => "an item",
        _ => "not an item",
    }
}
fn main() -> !int {
    print(say(Line.Item(Kind.Drink, 200)))
    print(say(Line.Item(Kind.Food, 275)))
    0
}
