2026-10-21T22:37:09.1381830Z git -c core.autocrlf=false clone --quiet https://github.com/wolffe-lang/wolf-std wolf-std
2026-10-21T22:37:09.1382617Z git -C wolf-std -c core.autocrlf=false checkout --quiet "${pin}"
