2026-10-21T22:35:40.4607648Z echo "staged std/: $(cd wolf-lang/target/release && find std -type f | wc -l) files, manifest ${got}"
2026-10-21T22:35:40.4608385Z if [ "${got}" != "${want}" ]; then echo "::error::staged std/ manifest ${got} is not the 0.2.34 archive's ${want}"; exit 1; fi
