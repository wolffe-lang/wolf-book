2026-10-21T22:35:40.4599740Z sha() { if command -v sha256sum >/dev/null; then sha256sum "$@"; else shasum -a 256 "$@"; fi; }
2026-10-21T22:35:40.4600380Z pin=$(awk -F' = ' '/^wolf-std-commit = /{print $2}' wolf-lang/crates/wolf_driver/STD-PIN)
2026-10-21T22:35:40.4600831Z echo "STD-PIN: ${pin}"
2026-10-21T22:35:40.4601107Z [ -n "${pin}" ]
2026-10-21T22:35:40.4601562Z git -c core.autocrlf=false clone --quiet https://github.com/wolffe-lang/wolf-std wolf-std
2026-10-21T22:35:40.4602172Z git -C wolf-std -c core.autocrlf=false checkout --quiet "${pin}"
2026-10-21T22:35:40.4602593Z dest=wolf-lang/target/release/std
2026-10-21T22:35:40.4602906Z rm -rf "${dest}"
2026-10-21T22:35:40.4603169Z cp -R wolf-std/std "${dest}"
2026-10-21T22:35:40.4603571Z cp wolf-std/LICENSE wolf-std/LICENSE-EXCEPTION "${dest}/"
2026-10-21T22:35:40.4603976Z printf '%s\n' "${pin}" > "${dest}/STD-REV"
2026-10-21T22:35:40.4604410Z # Each line written as `<hash>  <path>` by hand: windows' sha256sum
2026-10-21T22:35:40.4604892Z # marks binary mode (`*path`), which would move the manifest and
2026-10-21T22:35:40.4605263Z # nothing else.
2026-10-21T22:35:40.4605900Z got=$(cd wolf-lang/target/release && find std -type f | LC_ALL=C sort | while IFS= read -r f; do printf '%s  %s\n' "$(sha "$f" | cut -c1-64)" "$f"; done | sha | cut -c1-64)
