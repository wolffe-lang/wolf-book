2026-10-21T22:35:34.8728620Z git -c core.autocrlf=false clone --quiet https://github.com/wolffe-lang/wolf-std wolf-std
2026-10-21T22:35:34.8729160Z git -C wolf-std -c core.autocrlf=false checkout --quiet "${pin}"
