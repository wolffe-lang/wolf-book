//! check: fail(E1001)
//! phase: mem
// Exercise 3-2: one program, two verdicts — wolf rejects it statically,
// lupin traps it dynamically. Same rule, two enforcement points.
struct Pack { lead: str, tail: str }
fn adopt(take w: str) -> str { w }
fn main() -> !int {
    var p = Pack { lead: "ada", tail: "grace" }
    let a = adopt(take p.lead)
    let b = p.tail
    let c = p.lead
    print("{a} {b} {c}")
    0
}
