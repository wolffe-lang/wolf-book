//! check: run(exit=0, stdout="buzz")
//! phase: run
// Exercise 3-14, the reordered arms: `(_, 0)` above `(0, 0)` makes the
// second arm unreachable. Runs; the compiler warns by name (E0802).
fn fizzbuzz(n: int) -> str {
    match (n % 3, n % 5) {
        (_, 0) => "buzz",
        (0, 0) => "fizzbuzz",
        (0, _) => "fizz",
        _ => "{n}",
    }
}
fn main() -> !int {
    print(fizzbuzz(15))
    0
}
