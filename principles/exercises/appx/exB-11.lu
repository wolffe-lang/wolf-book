//! check: run(exit=trap(ub))
//! phase: run
// Appendix B, exercise B-11: ub — the oracle's finding, pinned as a trap
// expectation. The read is through a dangling pointer laundered as int.
import c "stdlib.h"

fn main() -> !int {
    unsafe {
        let p = c.malloc(8) as *u8
        c.memset(p, 5, 8)
        let address = p as int
        c.free(p)
        let q = address as *u8
        let v = q[0] as int
        v
    }
}
