//! check: run(exit=0)
//! phase: run
// Exercise 2-9 solution: bytes count storage, chars count scalars.
// Rejoined the run lane at the bs17 pin: lupin 0.1.16 reads char
// (is26), so the wolf-run scoping and the wolfrun/ subdirectory that
// isolated this file from the interpreter's module walk both retire.
fn main() -> !int {
    print("{"wolf".len} {"wolf".chars().len}")
    print("{"é".len} {"é".chars().len}")
    print("{"e\u{301}".len} {"e\u{301}".chars().len}")
    0
}
