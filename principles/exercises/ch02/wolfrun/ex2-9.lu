//! check: wolf-run(exit=0)
//! phase: run
// Exercise 2-9 solution: bytes count storage, chars count scalars.
// wolf-run lane (bs13 pin, lupin 0.1.14): the interpreter does not
// read char or chars() yet — `'` begins no token there and chars()
// answers unsupported by name; §2.4 says so on the page. The file
// sits in its own subdirectory because lupin 0.1.14 does not parse
// the wolf-run(…) header and would join this file into the chapter
// directory's module (D32), colliding with the lupin-lane mains.
fn main() -> !int {
    print("{"wolf".len} {"wolf".chars().len}")
    print("{"é".len} {"é".chars().len}")
    print("{"e\u{301}".len} {"e\u{301}".chars().len}")
    0
}
