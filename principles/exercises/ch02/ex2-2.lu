//! check: run(exit=0)
//! phase: run
// Exercise 2-2 solution: a two-column table via format specs.
fn main() -> !int {
    var names = List[str]()
    (mut names).push("wolf")
    (mut names).push("marmot")
    (mut names).push("elk")
    var i = 0
    for n in names {
        i += 1
        print("{n:<10}{i:>4}")
    }
    0
}
