//! check: wolf-run(exit=0, stdout="A-B--A--A-B")
//! phase: run
// Exercise 18-11: an L-system expanded at compile time.
// wolf-run lane, re-verified at the rp02 pin (2026-08-24): the compiler
// executes the fold natively; lupin still declines `comptime fn` by design
// (exit 4). Holds.
comptime fn expand(axiom: str, steps: int) -> str {
    var cur = axiom
    var step = 0
    while step < steps {
        var next = ""
        var i = 0
        while i < cur.len {
            let ch = cur.get(i..i + 1) else |_| { "" }
            if ch == "A" {
                next = "{next}A-B"
            } else if ch == "B" {
                next = "{next}-A"
            } else {
                next = "{next}{ch}"
            }
            i += 1
        }
        cur = next
        step += 1
    }
    cur
}
fn main() -> !int {
    const CURVE = expand("A", 3)
    print(CURVE)
    0
}
