//! phase: run
// Exercise 18-3: a table folded at compile time.
// PENDING: positive comptime evaluation (CTFE engine) — owner s16-ctfe.
comptime fn sum_squares(n: int) -> int {
    var acc = 0
    var i = 1
    while i <= n {
        acc += i * i
        i += 1
    }
    acc
}
fn main() -> !int {
    const T = sum_squares(9)
    print("{T}")
    0
}
