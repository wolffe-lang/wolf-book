//! check: wolf-run(exit=0)
//! phase: run
// Exercise 18-5: a function over a type.
// wolf-run lane, re-verified at the rp02 pin (2026-08-24, lupin 0.1.13):
// comptime reflection is the compiler's engine; lupin declines `comptime fn`
// by design (exit 4). Holds.
struct Howl {
    pitch: int,
    length: int,
    at_moon: bool,
}
comptime fn field_count(T: type) -> int {
    typeinfo(T).fields.len
}
fn main() -> !int {
    const N = field_count(Howl)
    print("{N}")
    0
}
