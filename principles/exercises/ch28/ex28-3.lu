//! check: run(exit=0)
//! phase: run
// Exercise 28-3: the frequency-sorted mode, as a second pass.
struct Node { word: str, count: int, left: List[Node], right: List[Node] }

fn leaf(w: str) -> Node {
    Node { word: w, count: 1, left: List[Node](), right: List[Node]() }
}

fn add(mut n: Node, w: str) {
    if w == n.word {
        n.count += 1
    } else if w < n.word {
        if n.left.is_empty() {
            (mut n.left).push(leaf(w))
        } else {
            add(mut n.left[0], w)
        }
    } else {
        if n.right.is_empty() {
            (mut n.right).push(leaf(w))
        } else {
            add(mut n.right[0], w)
        }
    }
}

fn walk(n: Node) {
    if !n.left.is_empty() { walk(n.left[0]) }
    print("{n.count:>4} {n.word}")
    if !n.right.is_empty() { walk(n.right[0]) }
}

fn collect(n: Node, mut ws: List[str], mut ns: List[int]) {
    if !n.left.is_empty() { collect(n.left[0], mut ws, mut ns) }
    (mut ws).push(n.word)
    (mut ns).push(n.count)
    if !n.right.is_empty() { collect(n.right[0], mut ws, mut ns) }
}

fn next_after(ws: List[str], ns: List[int], pc: int, pw: str, first: bool) -> int {
    var best = 0 - 1
    var i = 0
    while i < ws.len {
        let after = first || ns[i] < pc || (ns[i] == pc && ws[i] > pw)
        if after {
            if best < 0 {
                best = i
            } else if ns[i] > ns[best] || (ns[i] == ns[best] && ws[i] < ws[best]) {
                best = i
            }
        }
        i += 1
    }
    best
}

fn main() -> !int {
    let text = "The wolf runs\nthe moon watches the Wolf\n"
    region words {
        var forest = List[Node]()
        for w in text.lower().words() {
            if forest.is_empty() {
                (mut forest).push(leaf(w))
            } else {
                add(mut forest[0], w)
            }
        }
        var ws = List[str]()
        var ns = List[int]()
        if !forest.is_empty() { collect(forest[0], mut ws, mut ns) }
        var pc = 0
        var pw = ""
        var first = true
        var printed = 0
        while printed < ws.len {
            let k = next_after(ws, ns, pc, pw, first)
            if k < 0 { return 1 }
            print("{ns[k]:>4} {ws[k]}")
            pc = ns[k]
            pw = ws[k]
            first = false
            printed += 1
        }
    }
    0
}
