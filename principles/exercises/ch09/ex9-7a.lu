//! check: run(exit=0)
//! phase: run
// Exercise 9-7, legal half: the allocation lies inside the named region.
import c "stdlib.h"
fn main() -> !int {
    let r = region()
    // # Safety: the allocation is made while `r` is the ambient region,
    // so the door's claim is true; it is freed exactly once.
    unsafe {
        let p = in r { c.malloc(8) as *u8 }
        c.memset(p, 1, 8)
        let b = borrow r from p
        let v = b[0] as int
        c.free(p)
        if v == 1 { 0 } else { 1 }
    }
}
