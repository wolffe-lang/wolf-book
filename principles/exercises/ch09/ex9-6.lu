//! check: run(exit=trap(ub))
//! phase: run
// Exercise 9-6: reading memory nothing has written.
import c "stdlib.h"
fn main() -> !int {
    // # Safety: DELIBERATELY WRONG — the read happens before anything
    // writes the allocation.
    unsafe {
        let p = c.malloc(64) as *u8
        let v = p[0] as int
        c.free(p)
        print("{v}")
    }
    0
}
