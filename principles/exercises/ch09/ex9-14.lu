//! check: run(exit=trap(ub))
//! phase: run
// Exercise 9-14: the door's child tag, invalidated behind its back.
import c "stdlib.h"
fn main() -> !int {
    var words = 0
    let scratch = region()
    // # Safety: DELIBERATELY WRONG — the raw write goes around the
    // borrow the door handed to safe code.
    unsafe {
        let p = in scratch { c.malloc(8) as *u8 }
        c.memset(p, 9, 8)
        let counts = borrow scratch from p
        p[0] = 1
        words = counts[0] as int
        c.free(p)
    }
    words
}
