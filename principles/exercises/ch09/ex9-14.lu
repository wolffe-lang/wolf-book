//! check: run(exit=trap(ub))
//! phase: run
// Exercise 9-14: a foreign write while a parameter is protected.
import c "stdlib.h"
fn observe(a: *u8, mut b: *u8) -> int {
    b[0] = 3
    a[0] as int
}
fn main() -> !int {
    unsafe {
        let p = c.malloc(8) as *u8
        p[0] = 1
        var q = p
        let n = observe(p, mut q)
        c.free(p)
        n
    }
}
