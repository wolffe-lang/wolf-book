//! check: run(exit=trap(ub))
//! phase: run
// Exercise 9-7, illegal half: the door names a region the bytes are not in.
import c "stdlib.h"
fn main() -> !int {
    let r = region()
    unsafe {
        let p = c.malloc(8) as *u8
        c.memset(p, 1, 8)
        let b = borrow r from p
        let v = b[0] as int
        c.free(p)
        if v == 1 { 0 } else { 1 }
    }
}
