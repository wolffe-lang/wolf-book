//! check: run(exit=trap(ub))
//! phase: run
// Exercise 9-4: the pointer laundered through an int, and why it changes nothing.
import c "stdlib.h"
fn main() -> !int {
    // # Safety: DELIBERATELY WRONG — the integer roundtrip does not
    // revive the permission the free took away.
    unsafe {
        let p = c.malloc(8) as *u8
        c.memset(p, 5, 8)
        let address = p as int
        c.free(p)
        let q = address as *u8
        let v = q[0] as int
        v
    }
}
