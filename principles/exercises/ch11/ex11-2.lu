//! check: lupin-run(exit=trap(deadlock))
//! phase: run
// lupin lane, and by the specification rather than by a gap:
// `[conc.deadlock.trap]` REQUIRES deadlock detection in deterministic
// test modes and PERMITS it elsewhere, so the interpreter traps this
// program and a compiled binary is entitled to park on it forever.
// Measured at wolf 0.2.7 / lupin 0.1.27: `lupin` traps `deadlock`
// (exit 3); `wolf run` never returns. Not a debt, and nothing is
// owed — see principles/TWO-MACHINES.md §5.
// Exercise 11-2: the same program with a rendezvous channel — the
// receives sit on the wrong side of the join.
fn launch(s: Scope, ch: channel[int], n: int) {
    s.spawn(fn() { ch.send(n * 10) })
}
fn main() -> !int {
    let ch = channel[int](0)
    var total = 0
    scope s {
        launch(s, ch, 1)
        launch(s, ch, 2)
        launch(s, ch, 3)
    }
    for _ in 0..3 { total += ch.recv() else |_| { return 1 } }
    print("{total}")
    0
}
