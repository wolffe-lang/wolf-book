//! check: run(exit=0)
//! phase: run
// Exercise 11-1 solution: the scope travels as a value ([conc.task.scope],
// D16), typed by its prelude name `Scope` ([conc.proc.handle]).
fn launch(s: Scope, ch: channel[int], n: int) {
    s.spawn(fn() { ch.send(n * 10) })
}
fn main() -> !int {
    let ch = channel[int](3)
    var total = 0
    scope s {
        launch(s, ch, 1)
        launch(s, ch, 2)
        launch(s, ch, 3)
    }
    for _ in 0..3 { total += ch.recv() else |_| { return 1 } }
    print("{total}")
    0
}
