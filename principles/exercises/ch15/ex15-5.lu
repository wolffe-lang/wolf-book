//! check: run(exit=1)
//! phase: run
// Exercise 15-5 solution: a restart budget, exhausted honestly.
fn worker(attempt: int) -> !int { Crash }
fn main() -> !int {
    var attempt = 1
    while attempt <= 3 {
        let w = spawn proc worker(attempt)
        let m = w.monitor()
        select {
            exit(reason) from m => {
                if reason.is_normal() { print("attempt {attempt} succeeded"); return 0 }
                print("attempt {attempt} failed")
                attempt += 1
            },
            timeout(1.s) => { return 1 },
        }
    }
    print("giving up after 3 attempts")
    1
}
