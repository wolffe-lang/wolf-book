//! check: run(exit=0)
//! phase: run
// Exercise 15-1 solution: an error return is neither normal nor killed —
// the reason carries a third answer.
fn boom() -> !int { Bad }
fn main() -> !int {
    let w = spawn proc boom()
    let m = w.monitor()
    select {
        exit(reason) from m => {
            print("normal={reason.is_normal()} killed={reason.is_killed()}")
        },
        timeout(1.s) => { return 1 },
    }
    0
}
