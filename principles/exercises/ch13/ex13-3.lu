//! check: fail(E1101)
//! phase: resolve
// Exercise 13-3: the race that does not compile — two tasks capture
// plain mutable state. Both tools refuse it statically, E1101, same
// span; the compiler adds W1101 per spawn and W1102 on the second.
fn main() -> !int {
    var hits = 0
    scope s {
        s.spawn(fn() { hits += 1 })
        s.spawn(fn() { hits += 1 })
    }
    hits
}
