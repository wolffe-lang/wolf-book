//! check: run(exit=trap(overflow))
//! phase: run
// Exercise 21-5: the bill, when it arrives — the check costs a branch on
// every add, and pays out exactly at the boundary.
fn sum_to(n: i32) -> i32 {
    var acc: i32 = 0
    var i: i32 = 0
    while i < n {
        acc += 1000000
        i += 1
    }
    acc
}
fn main() -> !int {
    print("{sum_to(2000)}")
    print("{sum_to(3000)}")
    0
}
