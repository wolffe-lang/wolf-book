//! check: run(exit=0, stdout="mean 6 of 3")
//! phase: run
// Exercise 22-1: directory = module; `stats/` is the module, its files
// are invisible from here.
use stats

fn main() -> !int {
    var widths = List[int]()
    (mut widths).push(4)
    (mut widths).push(6)
    (mut widths).push(8)
    print("mean {stats.mean(widths)} of {stats.count(widths)}")
    0
}
