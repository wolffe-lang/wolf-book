//! check: run(exit=trap(stale-handle))
//! phase: run
// Exercise 8-12: a handle outlives its slot, and says so.
struct Node { value: int }
fn main() -> !int {
    region r: pool(Node) {
        var pool = Pool[Node]()
        let h = (mut pool).reserve()
        (mut pool).init(h, Node { value: 1 })
        (mut pool).remove(h)
        let v = pool[h].value
        v
    }
}
