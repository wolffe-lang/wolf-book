//! check: run(exit=0)
//! phase: run
// Exercise 14-3 solution: the proc dies, its region dies with it —
// no defer, no destructor, one bulk free.
fn build_then_crash() -> !int {
    let r = region()
    let n = in r {
        var xs = List[int]()
        for i in 0..100 { xs.push(i) }
        xs.len
    }
    Boom
}
fn main() -> !int {
    let w = spawn proc build_then_crash()
    let m = w.monitor()
    select {
        exit(reason) from m => {
            if reason.is_normal() { print("normal") } else { print("proc down; its regions are gone") }
        },
        timeout(1.s) => { return 1 },
    }
    0
}
