//! check: run(exit=0)
//! phase: run
// Exercise 14-6 solution: a counter as a mailbox-driven proc.
// Command 0 asks for the total; anything else adds.
fn counter(cmds: channel[int], replies: channel[int]) -> int {
    var total = 0
    for c in cmds {
        if c == 0 { replies.send(total) } else { total += c }
    }
    total
}
fn main() -> !int {
    let cmds = channel[int](8)
    let replies = channel[int](1)
    let w = spawn proc counter(cmds, replies)
    cmds.send(5)
    cmds.send(2)
    cmds.send(0)
    let t = replies.recv() else |_| { return 1 }
    print("total={t}")
    cmds.close()
    0
}
