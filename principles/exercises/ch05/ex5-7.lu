//! check: run(exit=0)
//! phase: run
// Exercise 5-7 solution: an RPN evaluator — the stack is a List.
fn eval_rpn(tokens: List[str]) -> int ! {Underflow, BadToken} {
    var stack = List[int]()
    for t in tokens {
        if t == "+" || t == "-" || t == "*" || t == "/" {
            if stack.len < 2 { return Underflow }
            let b = (mut stack).pop()
            let a = (mut stack).pop()
            if t == "+" { (mut stack).push(a + b) } else if t == "-" { (mut stack).push(a - b) } else if t == "*" { (mut stack).push(a * b) } else { (mut stack).push(a / b) }
        } else {
            let n = t.to_int() else { return BadToken }
            (mut stack).push(n)
        }
    }
    if stack.len != 1 { return Underflow }
    (mut stack).pop()
}
fn main() -> !int {
    var tokens = List[str]()
    (mut tokens).push("3")
    (mut tokens).push("4")
    (mut tokens).push("+")
    (mut tokens).push("2")
    (mut tokens).push("*")
    let v = eval_rpn(tokens) else |_| { return 1 }
    print("{v}")
    0
}
