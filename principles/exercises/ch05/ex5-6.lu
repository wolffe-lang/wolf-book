//! check: run(exit=0)
//! phase: run
// Exercise 5-6 solution: uniq, wolfished — first-seen order, one pass.
fn index_of(xs: List[str], s: str) -> int {
    var i = 0
    for x in xs {
        if x == s { return i }
        i += 1
    }
    0 - 1
}
fn main() -> !int {
    let log = """
        howl
        howl
        scratch
        howl
        scratch
        """
    var seen = List[str]()
    var counts = List[int]()
    for line in log.lines() {
        let at = index_of(seen, line)
        if at < 0 {
            (mut seen).push(line)
            (mut counts).push(1)
        } else {
            counts[at] = counts[at] + 1
        }
    }
    var i = 0
    for s in seen {
        print("{counts[i]:>4} {s}")
        i += 1
    }
    0
}
