//! check: run(exit=0)
//! phase: run
// Exercise 7-13 solution: the diff, read off the LCS table backward.
fn build_table(a: List[str], b: List[str]) -> List[List[int]] {
    var table = List[List[int]]()
    var i = 0
    while i <= a.len {
        var row = List[int]()
        var j = 0
        while j <= b.len {
            row.push(0)
            j += 1
        }
        table.push(row)
        i += 1
    }
    i = 1
    while i <= a.len {
        var j = 1
        while j <= b.len {
            if a[i - 1] == b[j - 1] {
                table[i][j] = table[i - 1][j - 1] + 1
            } else if table[i - 1][j] >= table[i][j - 1] {
                table[i][j] = table[i - 1][j]
            } else {
                table[i][j] = table[i][j - 1]
            }
            j += 1
        }
        i += 1
    }
    table
}
fn print_diff(a: List[str], b: List[str], table: List[List[int]], i: int, j: int) {
    if i > 0 && j > 0 && a[i - 1] == b[j - 1] {
        print_diff(a, b, table, i - 1, j - 1)
        print("  {a[i - 1]}")
    } else if j > 0 && (i == 0 || table[i][j - 1] >= table[i - 1][j]) {
        print_diff(a, b, table, i, j - 1)
        print("+ {b[j - 1]}")
    } else if i > 0 {
        print_diff(a, b, table, i - 1, j)
        print("- {a[i - 1]}")
    }
}
fn main() -> !int {
    var old = List[str]()
    old.push("the wolf runs")
    old.push("the moon watches")
    old.push("the elk listens")
    var new = List[str]()
    new.push("the wolf runs")
    new.push("the elk listens")
    new.push("the river answers")
    let table = build_table(old, new)
    print_diff(old, new, table, old.len, new.len)
    0
}
