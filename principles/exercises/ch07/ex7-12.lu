//! check: run(exit=0, stdout="2")
//! phase: run
// Exercise 7-12 solution: LCS length by dynamic programming.
fn lcs_len(a: List[str], b: List[str]) -> int {
    var table = List[List[int]]()
    var i = 0
    while i <= a.len {
        var row = List[int]()
        var j = 0
        while j <= b.len {
            (mut row).push(0)
            j += 1
        }
        (mut table).push(row)
        i += 1
    }
    i = 1
    while i <= a.len {
        var j = 1
        while j <= b.len {
            if a[i - 1] == b[j - 1] {
                table[i][j] = table[i - 1][j - 1] + 1
            } else if table[i - 1][j] >= table[i][j - 1] {
                table[i][j] = table[i - 1][j]
            } else {
                table[i][j] = table[i][j - 1]
            }
            j += 1
        }
        i += 1
    }
    table[a.len][b.len]
}
fn main() -> !int {
    var old = List[str]()
    (mut old).push("the wolf runs")
    (mut old).push("the moon watches")
    (mut old).push("the elk listens")
    var new = List[str]()
    (mut new).push("the wolf runs")
    (mut new).push("the elk listens")
    print("{lcs_len(old, new)}")
    0
}
